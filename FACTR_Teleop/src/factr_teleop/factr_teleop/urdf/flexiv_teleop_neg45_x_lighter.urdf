        <mesh filename="base_link.stl" scale="1 1 1" />
      </geometry>
      <material name="flexiv_teleop_mesh">
        <color rgba="0.72 0.72 0.72 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="base_link.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>

