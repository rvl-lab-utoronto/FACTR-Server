<?xml version='1.0' encoding='utf-8'?>
<robot name="flexiv_teleop_neg45_x_lighter">
  <link name="world" />
  <joint name="world_to_base_link_mount_neg45_x" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="-0.785398163397448 0 0" />
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.000138819690411 -0.0016195717167 -0.011398646033" rpy="0 0 0" />
      <mass value="0.111" />
      <inertia ixx="5.69431420711e-05" ixy="-1.89988345678e-08" ixz="2.12533886224e-07" iyy="5.70931531673e-05" iyz="-9.67738014848e-08" izz="4.0449892976e-05" />
