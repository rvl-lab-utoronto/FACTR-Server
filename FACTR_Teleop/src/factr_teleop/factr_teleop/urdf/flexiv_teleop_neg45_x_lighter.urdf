      <geometry>
        <mesh filename="link_6.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== NEW RAIL CARRIAGE (replaces old link_7) ==================== -->
  <link name="rail_carriage_link">
    <inertial>
      <!-- COM relative to the rotating point -->
      <origin xyz="-0.000011 -0.012076 -0.099800" rpy="0 0 0"/>
      <mass value="0.214492"/>
      <inertia
        ixx="0.0003724" ixy="1.9662e-8" ixz="3.2025e-7"
        iyy="0.0005962" iyz="-4.0624e-5"
        izz="0.0002672"/>
    </inertial>
    <visual>
      <!-- Mesh shifted so (0.047, 0.00145, 0.1888) becomes the link origin -->
      <origin xyz="-0.047 -0.00145 -0.1888" rpy="0 0 0"/>
      <geometry>
        <mesh filename="link_7.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_teleop_mesh">
        <color rgba="0.72 0.72 0.72 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.047 -0.00145 -0.1888" rpy="0 0 0"/>
      <geometry>
        <mesh filename="link_7.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== Joints ==================== -->

  <joint name="joint_1" type="revolute">
    <parent link="base_link" />
    <child link="link_1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="1" />
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1" />
    <child link="link_2" />
    <origin xyz="0.000130574300606631 0.0149399256994647 0.105023853734996" rpy="0 0 1.5707963267949" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="1" />
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2" />
    <child link="link_3" />
    <origin xyz="0.0175578765488817 -0.000114955516336591 0.102486962967077" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="1" />
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3" />
    <child link="link_4" />
    <origin xyz="-0.0151351676567868 0.00984254203913448 0.0949747" rpy="0 1.5707963267949 1.5707963267949" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="1" />
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4" />
    <child link="link_5" />
    <origin xyz="-0.0974849293854855 0.0120735844837713 -0.00937919999999989" rpy="-3.14159265358979 0 1.5707963267949" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="1" />
  </joint>

  <joint name="joint_6" type="revolute">
    <parent link="link_5" />
    <child link="link_6" />
    <origin xyz="-0.0154612367383675 -0.0949280431600081 -0.000667273159910339" rpy="-3.14159265358979 0 1.5707963267949" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="1" />
  </joint>

  <!-- Joint 7 – same pose as original, now driving the rail carriage -->
  <joint name="joint_7" type="revolute">
    <parent link="link_6" />
    <child link="rail_carriage_link" />
    <origin xyz="-0.0546971044967246 -0.0367701044967213 0.00756109816304664"
            rpy="-3.14159265358979 0 1.5707963267949" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.14159" upper="3.14159" effort="1" velocity="1" />
  </joint>
</robot>

